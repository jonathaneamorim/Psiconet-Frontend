# URL da API (Spring Boot). É embutida no build (NEXT_PUBLIC_*): rebuild ao alterar.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Durações de sessão NÃO são configuradas aqui: vêm da API (psiconet.session.* no backend, ADR 014).

# Customização de Nomes e Prefixos Internos
COOKIE_TOKEN_NAME=psiconet_token
ROLE_PREFIX=ROLE_
# Videochamada integrada (ADR 016 do backend): origens do provedor de vídeo liberadas na CSP
# (connect-src). Lida no build/start. Ex. LiveKit Cloud: "wss://*.livekit.cloud https://*.livekit.cloud".
# Vazio = nenhuma origem extra (a Sala Psiconet não consegue conectar). A flag em si fica no backend.
VIDEO_CSP_ORIGINS=
